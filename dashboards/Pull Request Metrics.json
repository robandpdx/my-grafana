      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Average # commits/PR",
          "description": "Daily average # of commits per PR grouped by PR opened date",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-athena-datasource",
                      "version": "v0",
                      "spec": {
                        "connectionArgs": {
                          "catalog": "__default",
                          "database": "__default",
                          "region": "__default",
                          "resultReuseEnabled": false,
                          "resultReuseMaxAgeInMinutes": 60
                        },
                        "format": 0,
                        "rawSQL": "WITH ranked_prs AS (\n  SELECT\n    created_at,\n    commits,\n    row_number() OVER (\n      PARTITION BY pull_request_id\n      ORDER BY\n        updated_at DESC NULLS LAST,\n        received_at DESC,\n        delivery_id DESC\n    ) AS rn\n  FROM github_webhooks_silver_dev.pull_requests\n  WHERE event_type = 'pull_request'\n    AND commits IS NOT NULL\n    AND $__timeFilter(created_at)\n)\nSELECT\n  date_trunc('day', created_at) AS time,\n  round(avg(commits), 2) AS avg_commits_per_pr\nFROM ranked_prs\nWHERE rn = 1\nGROUP BY 1\nORDER BY 1 ASC;",
                        "table": "pull_requests"
                      },
                      "labels": {
                        "grafana.app/export-label": "grafana-athena-datasource-1",
                        "grafana.app/export-datasource-name": "grafana-athena-datasource"
                      }
                    },
