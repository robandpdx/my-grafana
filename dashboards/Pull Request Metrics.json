      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "PR Velocity",
          "description": "Number of PRs opened and merged daily",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-athena-datasource",
                      "version": "v0",
                      "spec": {
                        "connectionArgs": {
                          "catalog": "__default",
                          "database": "__default",
                          "region": "__default",
                          "resultReuseEnabled": false,
                          "resultReuseMaxAgeInMinutes": 60
                        },
                        "format": 0,
                        "rawSQL": "WITH pr_activity AS (\n  SELECT\n    pull_request_id,\n    action,\n    CASE\n      WHEN action = 'opened' THEN created_at\n      ELSE merged_at\n    END AS activity_at\n  FROM github_webhooks_silver_dev.pull_requests\n  WHERE event_type = 'pull_request'\n    AND (\n      action = 'opened'\n      OR (action = 'closed' AND merged = true)\n    )\n)\nSELECT\n  date_trunc('day', activity_at) AS time,\n  count(DISTINCT CASE\n    WHEN action = 'opened' THEN pull_request_id\n  END) AS opened,\n  count(DISTINCT CASE\n    WHEN action = 'closed' THEN pull_request_id\n  END) AS merged\nFROM pr_activity\nWHERE $__timeFilter(activity_at)\nGROUP BY 1\nORDER BY 1 ASC;",
                        "table": "pull_requests"
                      },
                      "labels": {
                        "grafana.app/export-label": "grafana-athena-datasource-1",
                        "grafana.app/export-datasource-name": "grafana-athena-datasource"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
